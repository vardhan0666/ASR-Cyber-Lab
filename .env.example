# ==================================================
# ASR-Cyber-Lab Environment Configuration Template
# Copy this file to ".env" and set real values.
# NEVER commit the real ".env" file.
# ==================================================

# --- General ---
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- PostgreSQL ---
POSTGRES_USER=asr_user
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=asr_cyber_lab
POSTGRES_PORT=5432

# --- Backend ---
# Used when running the backend OUTSIDE docker-compose (docker-compose
# overrides this internally to point at the "db" service).
DATABASE_URL=postgresql+psycopg2://asr_user:change_me_strong_password@localhost:5432/asr_cyber_lab

# Must be a long random string in real deployments (min 16 chars enforced).
SECRET_KEY=change_me_to_a_random_secret_at_least_32_characters_long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173

# --- Nmap ---
NMAP_PATH=nmap
NMAP_TIMEOUT_SECONDS=600

# --- AI (optional, disabled by default) ---
AI_ENABLED=false
AI_PROVIDER=none
AI_API_KEY=

# --- Initial Admin Bootstrap (optional) ---
# If both are set AND the users table is empty, this account is created
# automatically on first startup. Leave unset to skip bootstrap; you will
# then need to seed a user directly in the database instead.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_FULL_NAME=Administrator

# --- Frontend ---
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8000